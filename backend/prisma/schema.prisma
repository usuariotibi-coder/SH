generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String               @id @default(cuid())
  name                String
  rfc                 String?
  address             String?
  industry            String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  alerts              Alert[]
  brigades            Brigade[]
  cmshMeetings        CMSHMeeting[]
  cmshMembers         CMSHMember[]
  drills              Drill[]
  fiveS               FiveS[]
  incidents           Incident[]
  trainings           Training[]
  users               User[]
  eppItems            EppItem[]
  eppAreaRequirements EppAreaRequirement[]
  eppLots             EppLot[]
  eppLoans            EppLoan[]
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  password           String
  role               Role            @default(AREA_MANAGER)
  area               String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  companyId          String
  brigadeMemberships BrigadeMember[]
  createdIncidents   Incident[]
  createdTrainings   Training[]
  company            Company         @relation(fields: [companyId], references: [id])
  eppMovements       EppMovement[]
}

model Evidence {
  id          String       @id @default(cuid())
  fileName    String
  fileUrl     String
  publicId    String
  fileType    EvidenceType
  fileSizeKb  Int?
  uploadedAt  DateTime     @default(now())
  description String?
  incidentId  String?
  drillId     String?
  fiveSId     String?
  drill       Drill?       @relation(fields: [drillId], references: [id], onDelete: Cascade)
  fiveS       FiveS?       @relation(fields: [fiveSId], references: [id], onDelete: Cascade)
  incident    Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Incident {
  id               String           @id @default(cuid())
  folio            String           @unique
  type             IncidentType
  severity         IncidentSeverity
  occurredAt       DateTime
  area             String
  description      String
  injuredName      String?
  injuredPosition  String?
  rootCause        String?
  correctiveAction String?
  imssReportNo     String?
  lostDays         Int?             @default(0)
  isReportedIMSS   Boolean          @default(false)
  isClosed         Boolean          @default(false)
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  companyId        String
  createdById      String
  evidences        Evidence[]
  company          Company          @relation(fields: [companyId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])
}

model CMSHMember {
  id        String    @id @default(cuid())
  name      String
  position  String
  cmshRole  CMSHRole
  email     String?
  phone     String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
}

model CMSHMeeting {
  id          String    @id @default(cuid())
  meetingDate DateTime
  location    String
  agenda      String
  agreements  String?
  attendees   String?
  nextMeeting DateTime?
  createdAt   DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
}

model Training {
  id               String    @id @default(cuid())
  name             String
  description      String?
  instructor       String
  trainingDate     DateTime
  durationHours    Float
  location         String?
  normReference    String?
  participants     String
  participantCount Int       @default(0)
  expirationDate   DateTime?
  isCompleted      Boolean   @default(true)
  createdAt        DateTime  @default(now())
  companyId        String
  createdById      String
  company          Company   @relation(fields: [companyId], references: [id])
  createdBy        User      @relation(fields: [createdById], references: [id])
}

model Drill {
  id               String     @id @default(cuid())
  type             DrillType
  plannedDate      DateTime
  executedDate     DateTime?
  participantCount Int?
  evacuationTime   Int?
  observations     String?
  correctives      String?
  isCompleted      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id])
  evidences        Evidence[]
}

model FiveS {
  id                 String     @id @default(cuid())
  area               String
  auditDate          DateTime
  seiriScore         Int
  seitonScore        Int
  seisoScore         Int
  seiketsuScore      Int
  shitsuke           Int
  totalScore         Float      @default(0)
  seiriFinding       String?
  seiriImmediate     String?
  seiriImprovement   String?
  seitonFinding      String?
  seitonImmediate    String?
  seitonImprovement  String?
  seisoFinding       String?
  seisoImmediate     String?
  seisoImprovement   String?
  seiketsuFinding    String?
  seiketsuImmediate  String?
  seiketsuImprovement String?
  shitsukeFinding    String?
  shitsukeImmediate  String?
  shitsukeImprovement String?
  observations       String?
  actionPlan         String?
  auditorName        String
  createdAt          DateTime   @default(now())
  companyId          String
  evidences          Evidence[]
  company            Company    @relation(fields: [companyId], references: [id])
}

model Alert {
  id          String    @id @default(cuid())
  type        AlertType
  title       String
  description String
  isRead      Boolean   @default(false)
  priority    Int       @default(1)
  relatedId   String?
  createdAt   DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
}

model Brigade {
  id           String          @id @default(cuid())
  type         BrigadeType
  description  String?
  objectives   String?
  meetingPoint String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  members      BrigadeMember[]

  @@unique([companyId, type])
}

model BrigadeMember {
  id                  String            @id @default(cuid())
  memberRole          BrigadeMemberRole @default(MEMBER)
  employeeName        String
  employeeArea        String?
  employeePosition    String?
  phone               String?
  startDate           DateTime          @default(now())
  endDate             DateTime?
  isActive            Boolean           @default(true)
  certificationDate   DateTime?
  certificationExpiry DateTime?
  notes               String?
  brigadeId           String
  userId              String?
  brigade             Brigade           @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  user                User?             @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  SH_SPECIALIST
  AREA_MANAGER
  AUDITOR
  EXECUTIVE
}

enum EvidenceType {
  PHOTO
  PDF
  DOCUMENT
  VIDEO
  OTHER
}

enum IncidentType {
  ACCIDENT
  INCIDENT
  NEAR_MISS
  OCCUPATIONAL_DISEASE
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
  FATAL
}

enum CMSHRole {
  PRESIDENT
  SECRETARY
  WORKER_REP
  EMPLOYER_REP
}

enum DrillType {
  FIRE
  EARTHQUAKE
  CHEMICAL_SPILL
  MEDICAL_EMERGENCY
  EVACUATION
  OTHER
}

enum AlertType {
  TRAINING_EXPIRING
  CMSH_MEETING_MISSING
  DRILL_PENDING
  EPP_LOAN
}

enum BrigadeType {
  FIRST_AID
  EVACUATION
  FIRE_FIGHTING
  SEARCH_RESCUE
}

enum BrigadeMemberRole {
  COORDINATOR
  DEPUTY
  MEMBER
}

// ── EPP ───────────────────────────────────────────────────────────────────────

enum EppMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
}

model EppItem {
  id               String               @id @default(cuid())
  name             String
  category         String
  description      String?
  unit             String               @default("pieza")
  minStock         Int                  @default(0)
  maxStock         Int                  @default(0)
  currentStock     Int                  @default(0)
  partNumber       String?
  brand            String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id])
  movements        EppMovement[]
  areaRequirements EppAreaRequirement[]
  lots             EppLot[]
  loanItems        EppLoanItem[]
}

model EppMovement {
  id             String          @id @default(cuid())
  type           EppMovementType
  quantity       Int
  balanceAfter   Int
  employeeName   String?
  employeeArea   String?
  frequency      String?
  supplier       String?
  price          Float?
  reason         String?
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now())
  eppItemId      String
  eppItem        EppItem         @relation(fields: [eppItemId], references: [id])
  registeredById String
  registeredBy   User            @relation(fields: [registeredById], references: [id])
}

model EppAreaRequirement {
  id              String   @id @default(cuid())
  areaName        String
  mandatory       Boolean  @default(true)
  notes           String?
  userCount       Int      @default(1)
  changeFrequency String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  eppItemId       String
  eppItem         EppItem  @relation(fields: [eppItemId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])

  @@unique([eppItemId, areaName, companyId])
}

model EppLoan {
  id           String        @id @default(cuid())
  employeeName String
  employeeArea String?
  loanDate     DateTime      @default(now())
  returnedAt   DateTime?
  isReturned   Boolean       @default(false)
  notes        String?
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  items        EppLoanItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model EppLoanItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  loanId    String
  loan      EppLoan  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  eppItemId String
  eppItem   EppItem  @relation(fields: [eppItemId], references: [id])
}

model EppLot {
  id        String   @id @default(cuid())
  quantity  Int
  remaining Int
  unitPrice Float    @default(0)
  createdAt DateTime @default(now())
  eppItemId String
  eppItem   EppItem  @relation(fields: [eppItemId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}
